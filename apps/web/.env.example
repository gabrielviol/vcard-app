# URL base do apps/api local (perfil "http" do launchSettings.json, ver 01-01-SUMMARY.md).
# Variavel publica (roda no browser) - nunca colocar segredo aqui.
NEXT_PUBLIC_API_URL=http://localhost:5153

# Token de escrita do Vercel Blob Store (CARD-09) -- Vercel Dashboard -> Storage ->
# Create Blob Store -> aba .env.local. Server-only: SEM prefixo NEXT_PUBLIC_, lido
# apenas em apps/web/app/api/upload/route.ts (Route Handler, nunca no bundle do cliente).
BLOB_READ_WRITE_TOKEN=

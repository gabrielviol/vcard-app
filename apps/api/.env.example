# Connection string Npgsql para o Postgres.
# IMPORTANTE: nunca omitir o parametro "SSL Mode" — o default do Npgsql (Prefer) nao valida
# certificado e e explicitamente vetado no CLAUDE.md.
#
# Local (Docker Compose): o container "postgres" oficial nao tem SSL habilitado por padrao,
# entao o modo local usa SSL Mode=Disable, explicito.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=vcard;Username=vcard;Password=vcard;SSL Mode=Disable

# Deploy (Neon): TLS deve ser validado. Trocar a linha acima por algo como:
# ConnectionStrings__Default=Host=<neon-host>;Port=5432;Database=<db>;Username=<user>;Password=<pass>;SSL Mode=Require;Trust Server Certificate=true

# Chave HMAC usada para assinar/validar o JWT auto-emitido. Nunca hardcoded, nunca versionado.
JWT_SECRET=troque-esta-chave-por-um-segredo-forte-em-producao

# Configuracao do JWT (valores locais)
Jwt__Issuer=vcard-api
Jwt__Audience=vcard-web
Jwt__ExpiresMinutes=20

# Origem permitida no CORS (frontend local)
Cors__WebOrigin=http://localhost:3000
